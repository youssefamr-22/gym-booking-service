# Copy this file to .env and adjust the values for your machine (Lab 4).
# Easier: bash infra/setup-all.sh writes a ready .env for you.
# .env is never committed. Never put a real password or key in THIS file.
PORT=3003
NODE_ENV=development
SERVICE_NAME=booking-service
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
# Floci accepts any value: these two are NOT real AWS keys.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
COGNITO_USER_POOL_ID=<COGNITO_USER_POOL_ID from infra/.generated/outputs.env>
COGNITO_CLIENT_ID=<COGNITO_CLIENT_ID from infra/.generated/outputs.env>
CORS_ORIGINS=http://localhost:8080
CLASS_SERVICE_URL=http://localhost:3002
BOOKING_SERVICE_URL=http://localhost:3003
ATTENDANCE_SERVICE_URL=http://localhost:3004
LOG_GROUP_NAME=/gym/booking-service
SHIP_LOGS_TO_CLOUDWATCH=true
REPORTS_KMS_KEY_ID=<KMS_KEY_ARN from infra/.generated/outputs.env>
EMAIL_SENDER_ADDRESS=<a sender address verified in your Brevo account>
